# Template only. Copy to .env.local and put real values there.
# .env.local is ignored by git; this file is committed, so never put a real key here.

# Set ONE AI key.
# Free: create a key in Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=
# Or paid: https://console.anthropic.com (set a monthly spend limit there).
ANTHROPIC_API_KEY=

# Optional. "gemini" or "claude" when both keys are set (Claude wins by default).
AI_PROVIDER=
# Optional. Overrides the default Gemini model (gemini-flash-latest).
GEMINI_MODEL=

# Optional. Signs warning links so nobody can forge a verdict.
# If empty, a secret is derived from the AI key on the server.
SHARE_SECRET=
